# Kong owns the Status API listener. The deployment authority owns network
# attachment and must not publish 8100 to the host or route it through Caddy.
KONG_STATUS_LISTEN=0.0.0.0:8100
KONG_STATUS_ACCESS_LOG=off
KONG_STATUS_ERROR_LOG=stderr
CODESTRA_OBSERVABILITY_NETWORK=codestra-observability
CODESTRA_OBSERVABILITY_ALIAS=kong
