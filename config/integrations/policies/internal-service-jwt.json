{
  "apiVersion": "codestra.gateway/v1",
  "authenticationMode": "oidc",
  "kind": "GatewayPolicy",
  "maximumBodyBytes": 1048576,
  "maximumTimeoutMs": 60000,
  "name": "internal-service-jwt",
  "newProductionAllowed": true,
  "plugins": [
    "openid-connect",
    "codestra-authz",
    "ip-restriction"
  ]
}
