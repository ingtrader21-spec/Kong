      ],
      "mechanisms": [
        "OIDC_BEARER_CLAIM_GUARD",
        "OIDC_BEARER"
      ],
      "issuerProfile": "environment",
      "audienceProfiles": [
        "CONTROL_PLANE",
        "MIDDLEWARE_API"
      ],
      "scopes": "route",
      "authorizedParties": "consumer-mapped",
      "failurePolicy": "FAIL_CLOSED_V1",
      "tokenCache": "OIDC_CACHE_V1",
      "strength": 4
    },
    "SERVICE_JWT_V1": {
      "accessClasses": [
        "SERVICE_AUTHENTICATED"
      ],
      "principalClasses": [
        "SERVICE"
      ],
      "mechanisms": [
        "JWT_RS256_CLAIM_GUARD"
      ],
      "issuerProfile": "environment",
      "audienceProfiles": [
        "CALLBACK_API",
        "CAMPAIGN_MIDDLEWARE",
        "MIDDLEWARE_API"
      ],
      "scopes": "route",
      "authorizedParties": "explicit",
      "failurePolicy": "FAIL_CLOSED_V1",
      "tokenCache": "JWT_STATIC_KEY_V1",
