        "AUTHENTICATED"
      ],
      "principalClasses": [
        "HUMAN"
      ],
      "mechanisms": [
        "OIDC_BEARER_CLAIM_GUARD",
        "OIDC_BEARER"
      ],
      "issuerProfile": "environment",
      "audienceProfiles": [
        "MONEYBEE_API",
        "MIDDLEWARE_API"
      ],
      "scopes": "route",
      "authorizedParties": "explicit",
      "failurePolicy": "FAIL_CLOSED_V1",
      "tokenCache": "OIDC_CACHE_V1",
      "strength": 3
    },
    "HUMAN_SESSION_OIDC_V1": {
