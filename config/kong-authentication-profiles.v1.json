    "AUTHENTICATED": 1,
    "SERVICE_AUTHENTICATED": 4,
    "ADMIN_INTERNAL": 5,
    "INTERNAL": 4
  },
  "canonicalMinimumStrength": {
    "PUBLIC": 0,
    "AUTHENTICATED": 3,
    "SERVICE_AUTHENTICATED": 4,
    "ADMIN_INTERNAL": 5,
    "INTERNAL": 4
  },
  "rules": {
    "wildcardAudienceAllowed": false,
    "wildcardScopeAllowed": false,
    "clientIdIsAudienceRequiresContract": true,
    "humanProfilesForbiddenOn": [
      "SERVICE_AUTHENTICATED",
      "INTERNAL",
      "ADMIN_INTERNAL"
    ],
    "serviceProfilesForbiddenOn": [
      "ADMIN_INTERNAL"
    ],
    "identityHeaderAuthorityAllowed": false,
    "maximumLeewaySeconds": 60,
    "maximumCacheTtlSeconds": 3600
  }
}
