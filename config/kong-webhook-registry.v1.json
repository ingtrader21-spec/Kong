{
  "schema_version": 1,
  "kind": "codestra.kong.webhook-registry.v1",
  "status": "SOURCE_ONLY_NO_RUNTIME_APPLY",
  "runtime_apply_authorized": false,
  "provider_effects_enabled": false,
  "purpose": "Gateway transport/identity registry only. Signature verification, replay protection, business authorization, event durability and provider-event ledgers remain owned by Middleware or the named downstream application.",
  "canonical_entries": [
    {
      "id": "odoo-events",
      "method": "POST",
      "path": "/api/v1/odoo/events",
      "classification": "CANONICAL_SHARED_EDGE",
      "calling_client": "odoo-integration",
      "audience": "middleware-api",
      "scope": "odoo.events.publish",
      "auth": "odoo-service-jwt",
      "idempotency": {
        "required": true,
        "carrier": "body.event_id"
      },
      "gateway": "Kong",
      "upstream": "middleware-integration-api:8095",
      "signature_verification_owner": "Middleware/contract-defined",
      "replay_protection_owner": "Middleware",
      "event_ledger_owner": "Middleware",
      "gateway_retries": 0
    },
    {
      "id": "n8n-results",
      "method": "POST",
      "path": "/api/v1/integrations/n8n/results",
      "classification": "CANONICAL_SHARED_EDGE",
