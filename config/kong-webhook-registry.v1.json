      "audience": "middleware-api",
      "scope": "n8n.results.submit",
      "auth": "n8n-service-jwt",
      "idempotency": {
        "required": true,
        "carrier": "Idempotency-Key"
      },
      "gateway": "Kong",
      "upstream": "middleware-integration-api:8095",
      "signature_verification_owner": "not-applicable/service-jwt",
      "replay_protection_owner": "Middleware/idempotency",
      "event_ledger_owner": "Middleware",
      "gateway_retries": 0
    },
    {
      "id": "github-events",
      "method": "POST",
      "path": "/platform/v1/integrations/github/events",
      "classification": "CANONICAL_SHARED_EDGE",
      "calling_client": "github-app",
      "audience": "middleware-api",
      "scope": "github.webhooks.publish",
      "auth": "service-or-user-jwt",
      "idempotency": {
        "required": true,
        "carrier": "Idempotency-Key"
      },
      "gateway": "Kong",
      "upstream": "middleware-integration-api:8095",
      "signature_verification_owner": "Middleware/contract-defined",
      "replay_protection_owner": "Middleware/idempotency",
      "event_ledger_owner": "Middleware",
      "gateway_retries": 0
    }
  ],
